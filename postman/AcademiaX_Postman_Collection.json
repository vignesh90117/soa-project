{
  "info": {
    "_postman_id": "a8921b4f-8012-4c22-9988-academiax2026",
    "name": "AcademiaX Microservices API Suite (PS035)",
    "description": "Comprehensive Postman API Collection for AcademiaX Higher Education Enrollment & Tuition Processing Microservices (Eureka, API Gateway, Auth, Course, Enrollment, Payment) with HMAC-SHA256 JWT Security.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
